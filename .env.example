# Cấu hình địa chỉ API Backend FactoryCare Mobile
# Giá trị 'auto' giúp tự động nhận diện địa chỉ máy chủ khi quét mã QR Wi-Fi hoặc cắm cáp USB
EXPO_PUBLIC_API_BASE_URL=auto

# Các tùy chọn thủ công khác khi cần (bỏ dấu # đầu dòng để kích hoạt):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.35:3005/api
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3005/api
